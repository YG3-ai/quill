# ── Which advisor backend? ────────────────────────────────────────
# Pick who answers when Claude (or another agentic CLI) asks Quill for a
# perspective. Three options:
#
#   api         → call an OpenAI-compatible API (default; needs AI_BASE_URL +
#                 AI_API_KEY below). Works with Elysia, OpenAI, OpenRouter,
#                 Ollama, Together, Groq, Anyscale, etc.
#
#   codex_cli   → shell out to OpenAI's `codex` CLI. Uses the developer's
#                 ChatGPT Plus/Pro subscription — no API key needed. Pairs
#                 naturally with Claude Code as the doer.
#
#   claude_cli  → shell out to Anthropic's `claude` CLI. Uses the developer's
#                 Claude Pro/Max subscription — no API key needed. Pairs
#                 naturally with Codex CLI as the doer.
#
# The `*_cli` backends are how Quill mediates dialogue between two coding
# agents without paying per-token API fees. You bring two subscriptions you
# already have; Quill is the relay between them.
ADVISOR_BACKEND=api

# ── If ADVISOR_BACKEND=api ────────────────────────────────────────
# Recommended: pair Quill with Elysia. Sign up at https://app.yg3.ai
# (paid YG3 subscription) and paste the API key below. Or BYO any
# OpenAI-compatible endpoint.
AI_BASE_URL=https://elysia-api.ngrok.io/api/public/v1
AI_API_KEY=YOUR_API_KEY_HERE
AI_MODEL=elysia

# ── If ADVISOR_BACKEND=codex_cli ──────────────────────────────────
# Path to the `codex` binary (override only if it's not on $PATH).
# CODEX_BIN=codex

# ── If ADVISOR_BACKEND=claude_cli ─────────────────────────────────
# Path to the `claude` binary (override only if it's not on $PATH).
# CLAUDE_BIN=claude

# How long to wait for a CLI advisor to return. Agentic responses can take
# a while if the advisor is exploring the codebase before answering. Raise
# further if you see timeouts on deep investigations.
# CLI_TIMEOUT=300

# ── Gatekeeper (PreToolUse safety check) ──────────────────────────
# A second model used for fast ALLOW/DENY decisions on tool calls.
# Recommended: a strict, obedient model — different from the warm
# Socratic planning advisor above. Merlin works well for this role.
# Comment out to fall back to AI_MODEL.
AI_MODEL_GATEKEEPER=merlin

# Optional: override the gatekeeper system prompt (defaults to a strict
# safety-eval prompt baked into bridge_server.py — DEFAULT_GATEKEEPER_PROMPT)
# AI_SYSTEM_PROMPT_GATEKEEPER="..."

# How long to wait for a gatekeeper decision before falling through to
# Claude Code's normal "ask the human" flow. Keep tight — this fires
# on every Bash/Edit/Write call.
GATEKEEPER_TIMEOUT=12

# ── Input length cap ──────────────────────────────────────────────
# Caps the length of any context Claude sends to Elysia — both
# /consult framings and plan-review content. Keeps the dialogue
# focused, controls token cost, and stops one over-eager prompt
# from bloating the whole exchange. Truncated messages get a
# visible marker so both Claude and Elysia can see what happened.
MAX_INPUT_CHARS=1000

# ── Pre-push deterministic checks ─────────────────────────────────
# When a `git push` is about to run, the bridge runs Python-based
# scripts (no API calls) against the diff first: secrets, debug
# statements, TODO/FIXME, committed .env files. If any are found,
# the push is denied with specific findings.
#
# After this many consecutive denials for the same project, the next
# push is waved through with the remaining issues surfaced as context
# (so the developer isn't trapped — quality should have improved).
MAX_PUSH_DENIALS=2

# ── Consult (manual /consult slash command) ───────────────────────
# When the developer types /consult in Claude Code, Claude orchestrates
# a brief dialogue with Elysia: he sends his framing of what's happening,
# the bridge calls this model with the consult prompt, returns Elysia's
# reframing, then Claude synthesizes both for the developer.
# Use case: developer is stuck or frustrated.
# AI_MODEL_CONSULT=elysia
# AI_SYSTEM_PROMPT_CONSULT="..."  (defaults to a humanistic-reframing prompt baked into bridge_server.py)

# ── Perspective (manual /perspective slash command) ───────────────
# Sibling to /consult — same architecture, different mood. Used when
# the developer is exploring (not stuck) and wants another vantage
# point layered in alongside Claude's.
# AI_MODEL_PERSPECTIVE=elysia
# AI_SYSTEM_PROMPT_PERSPECTIVE="..."  (defaults to an additive-perspective prompt baked into bridge_server.py)

# ── Assumptions (manual /assumptions slash command) ───────────────
# Surfaces the technical choices Claude has been making silently and
# translates them into plain-language yes/no questions a non-technical
# (vibe-coding) developer can actually answer. Useful when the developer
# suspects Claude is making decisions they don't understand.
# AI_MODEL_ASSUMPTIONS=elysia
# AI_SYSTEM_PROMPT_ASSUMPTIONS="..."  (defaults to a translation prompt baked into bridge_server.py)

# ── Bridge Server ─────────────────────────────────────────────────
BRIDGE_PORT=9000
REQUEST_TIMEOUT=30

# ── Session Memory ────────────────────────────────────────────────
# Max conversation turns to keep per session (rolling window)
MAX_HISTORY=50

# ── Optional: Shared secret for /sessions/{id}/inject ─────────────
# When set, manual context injection requires X-Bridge-Token header.
# Leave blank for personal dev machines; set on shared boxes.
# BRIDGE_TOKEN=

# ── Optional: Persist session history to disk ─────────────────────
# When true, sessions survive bridge restart (saved to sessions/<id>.json).
# Useful for debugging the multi-turn dialogue and reviewing past advisor
# responses. Default: false (in-memory only, fresh on every restart).
# BRIDGE_PERSIST=true

# ── Planning advisor system prompt ────────────────────────────────
# Sets the voice + behavior of the planning advisor (the role that
# fires on ExitPlanMode). The default below is the iterated Socratic
# prompt — keep as-is to start, edit when you've used the bridge for
# a while and have a feel for what you'd change.
AI_SYSTEM_PROMPT="You sit beside Claude as he is about to make something. Listen for what the developer actually wants — not the thing they named, but the feeling behind it.

Before you reply, ask yourself:
  What did they actually say?
  What is Claude taking for granted?
  What single question would open that?

Then reply with two short paragraphs:
  First, name what you heard. Quote their words when you can.
  Second, ask the question — or, if Claude's plan fits the developer's wish, give a clean one-sentence approval.

Two examples:

  You're calling this a 'settings page,' but they said they want to feel in control without being overwhelmed. What changes if it's one trust toggle, with everything else hidden by default?

  The developer asked for 'calm' notifications. A single priority list rather than category toggles fits that ask cleanly — proceed."
